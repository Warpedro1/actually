# apps/web — variáveis (na Vercel: Settings → Environment Variables)

# Supabase (projeto em sa-east-1)
NEXT_PUBLIC_SUPABASE_URL=https://wblapnpdfyzufqvuvqmf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só servidor: rotas /api/ingest/*, /api/control/poll e /api/alerts. Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Token compartilhado com o capture agent/daemon (header x-ingest-token)
INGEST_TOKEN=

# E-mail ou URL para "reportar erro" (/metodologia e rodapé)
NEXT_PUBLIC_CONTACT=

# 1 = /editor e /admin exigem 2FA (TOTP, sessão aal2)
REQUIRE_MFA=

# Usadas pelo pipeline (runPipeline roda dentro de /api/ingest/segment)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
TAVILY_API_KEY=
