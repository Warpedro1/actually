# apps/web — variáveis (na Vercel: Settings → Environment Variables)

# Supabase (projeto em sa-east-1)
NEXT_PUBLIC_SUPABASE_URL=https://wblapnpdfyzufqvuvqmf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só servidor: rotas /api/ingest/*, /api/control/poll, /api/alerts e /api/kb/*. Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Token compartilhado com o capture agent/daemon (header x-ingest-token)
INGEST_TOKEN=

# E-mail ou URL para "reportar erro" (/metodologia e rodapé)
NEXT_PUBLIC_CONTACT=

# 1 = /editor e /admin exigem 2FA (TOTP, sessão aal2) na interface.
# No banco, vale por editor: editors.mfa_required = true (ver README, seção 2FA).
REQUIRE_MFA=

# Usadas pelo pipeline (runPipeline roda dentro de /api/ingest/segment)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
TAVILY_API_KEY=
# A base aprende com a web: páginas da busca web viram base em segundo plano. 0 desliga.
# KB_LEARN_FROM_WEB=0

# Carga da base pelo /admin (rotas /api/kb/*; VOYAGE_API_KEY acima também vale aqui)
# Autentica a continuação entre rodadas e o cron diário (vercel.json). Gerar: openssl rand -hex 32
CRON_SECRET=
GOOGLE_FACTCHECK_API_KEY=
APIFY_TOKEN=

# Painel "Uso das APIs" do /admin (opcionais; sem elas o cartão diz qual falta)
# Admin key da organização Anthropic (sk-ant-admin…): custo oficial do mês. Nunca usada pelo pipeline.
ANTHROPIC_ADMIN_KEY=
# Saldo da Deepgram (chave com leitura de cobrança; a captura usa a da máquina)
DEEPGRAM_API_KEY=
# Limite de banco do plano Supabase em MB (padrão 500 = gratuito)
SUPABASE_DB_LIMIT_MB=
